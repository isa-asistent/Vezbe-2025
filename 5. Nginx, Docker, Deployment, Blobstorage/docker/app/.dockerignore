# .dockerignore govori Dockeru koje fajlove da izostavi iz build context-a.
# Build context je direktorijum (kod nas ./app) koji Docker spakuje i posalje
# Docker izvrsnom okruzenju pri svakom build-u. COPY instrukcije mogu da uzmu samo ono sto je u njemu.
# Sve sto navedemo ovde se uopste ne salje, sto ubrzava build i sprecava da
# nezeljeni fajlovi (npr. .env ili .git) slucajno zavrse u slici.
# Mora se nalaziti u korenu build context-a, odnosno pored Dockerfile-a.

target/
.git/
.gitignore
.idea/
.vscode/
*.iml
.env
Dockerfile
.dockerignore